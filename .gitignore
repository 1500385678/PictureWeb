# 调试中间产物
_ai_req.json
_ai_video_req.json
*.tmp
# 临时 python 脚本(_xxx.py / _test_*.py 之类)
_*.py
# 测试用临时目录(其他项目的 .AutoEvolution 误入)
.AutoEvolution/

# ===== 日志(daemon/server 输出,本地诊断用)=====
server.out
server.err
daemon.out
daemon.err
*.log
# logs/ 整个目录(9001/8082/9003 各端口 server 输出 + 临时启动 log)
logs/

# ===== 缩略图缓存(PIL 运行时生成)=====
thumbs/
__thumbs__/
.cache/

# ===== 数据库(SQLite 文件 + 备份)=====
# PictureDb.db 是兄弟模块共用的,不能进本仓库
PictureDb.db
*.db-journal
*.db-wal
*.db-shm
# 备份
*.bak
*.db.bak

# ===== Python 缓存 =====
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

